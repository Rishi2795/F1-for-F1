# Base URL of the API, including /api. Required in production (Vercel project settings).
VITE_API_URL=http://localhost:8000/api
# Optional: collector that receives sanitized client-side error events via sendBeacon.
# VITE_ERROR_ENDPOINT=
# Official driver portraits (Formula 1's own images, shown from formula1.com with a credit). Set to off to show only the number design.
# VITE_DRIVER_HEADSHOTS=off
